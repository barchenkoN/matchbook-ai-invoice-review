# Set these as process environment variables. This file is not auto-loaded.
# Native startup defaults to SQLite. PostgreSQL support is configured via SQLAlchemy.
# DATABASE_URL=postgresql+psycopg://matchbook:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/matchbook
MATCHBOOK_DEMO_AUTH=1
# For real local credentials: set demo auth to 0 and provide both passwords.
# MATCHBOOK_REVIEWER_PASSWORD=
# MATCHBOOK_VIEWER_PASSWORD=
LLM_BASE_URL=http://127.0.0.1:8091/v1
ERP_MODE=sandbox
# Real ERPNext requires a tested instance and custom unique reference field.
# ERP_MODE=erpnext
# ERP_URL=http://127.0.0.1:8080
# ERP_COMPANY=
# ERP_API_KEY=
# ERP_API_SECRET=
# ERP_REFERENCE_FIELD=custom_matchbook_reference
